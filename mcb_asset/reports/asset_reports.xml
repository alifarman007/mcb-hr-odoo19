<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Annexure-07 Fixed Assets Register -->
    <record id="action_report_mcb_asset_register" model="ir.actions.report">
        <field name="name">Fixed Assets Register (Annexure-07)</field>
        <field name="model">mcb.asset.register.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">mcb_asset.report_mcb_asset_register</field>
        <field name="report_file">mcb_asset.report_mcb_asset_register</field>
    </record>

    <template id="report_mcb_asset_register">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="rows" t-value="doc._rows()"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <div style="text-align:center;">
                            <h3 style="margin:0;">Mukti Cox's Bazar</h3>
                            <h4>Fixed Assets Register</h4>
                        </div>
                        <p>
                            <strong>Project/Office:</strong> <t t-out="doc.project_name or (doc.project_analytic_id.name or 'All')"/> ·
                            <strong>Funded By:</strong> <t t-out="doc.funded_by or ''"/> ·
                            <strong>Period:</strong> <t t-out="doc.date_from"/> — <t t-out="doc.date_to"/>
                        </p>
                        <table class="table table-sm table-bordered" style="font-size:7.5pt;">
                            <thead style="background:#eee;">
                                <tr>
                                    <th>Sl</th><th>Description</th><th>ID Number</th><th>Purchase Date</th>
                                    <th class="text-end">Cost</th><th>Rate</th>
                                    <th class="text-end">Dep. Opening</th><th class="text-end">Charge</th>
                                    <th class="text-end">Adj.</th><th class="text-end">Dep. Closing</th>
                                    <th class="text-end">WDV</th><th>Location</th><th>Condition</th><th>User</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="i" t-value="0"/>
                                <t t-foreach="rows" t-as="r">
                                    <t t-set="i" t-value="i + 1"/>
                                    <tr>
                                        <td><t t-out="i"/></td>
                                        <td><t t-out="r['asset'].name"/></td>
                                        <td><t t-out="r['code']"/></td>
                                        <td><t t-out="r['date'] or ''"/></td>
                                        <td class="text-end"><t t-out="'%.0f' % r['cost']"/></td>
                                        <td><t t-out="r['rate']"/>%</td>
                                        <td class="text-end"><t t-out="'%.0f' % r['opening']"/></td>
                                        <td class="text-end"><t t-out="'%.0f' % r['charge']"/></td>
                                        <td class="text-end"><t t-out="'%.0f' % r['adjustment']"/></td>
                                        <td class="text-end"><t t-out="'%.0f' % r['closing']"/></td>
                                        <td class="text-end"><t t-out="'%.0f' % r['wdv']"/></td>
                                        <td><t t-out="r['location']"/></td>
                                        <td><t t-out="r['condition']"/></td>
                                        <td><t t-out="r['user']"/></td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr style="background:#eee;">
                                    <th colspan="4">Total Value</th>
                                    <th class="text-end"><t t-out="'%.0f' % sum(r['cost'] for r in rows)"/></th>
                                    <th colspan="5"/>
                                    <th class="text-end"><t t-out="'%.0f' % sum(r['wdv'] for r in rows)"/></th>
                                    <th colspan="3"/>
                                </tr>
                            </tfoot>
                        </table>
                        <table style="width:100%; margin-top:40px; text-align:center; font-size:9pt;">
                            <tr>
                                <td style="border-top:1px solid #000; width:30%;">Prepared By</td>
                                <td style="width:5%;"/>
                                <td style="border-top:1px solid #000; width:30%;">Reviewed By</td>
                                <td style="width:5%;"/>
                                <td style="border-top:1px solid #000; width:30%;">Approved By</td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- Annexure-22 Physical Inventory -->
    <record id="action_report_mcb_asset_inventory" model="ir.actions.report">
        <field name="name">Asset Physical Inventory (Annexure-22)</field>
        <field name="model">mcb.asset.inventory</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">mcb_asset.report_mcb_asset_inventory</field>
        <field name="report_file">mcb_asset.report_mcb_asset_inventory</field>
        <field name="binding_model_id" ref="model_mcb_asset_inventory"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_mcb_asset_inventory">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div style="text-align:center;">
                            <h3 style="margin:0;">Mukti Cox's Bazar</h3>
                            <h4>Fixed Assets Physical Inventory Report</h4>
                        </div>
                        <p>
                            <strong>Project/Office:</strong> <t t-out="doc.project_name or ''"/> ·
                            <strong>Funded By:</strong> <t t-out="doc.funded_by or ''"/> ·
                            <strong>Reporting Date:</strong> <t t-out="doc.date"/>
                        </p>
                        <table class="table table-sm table-bordered" style="font-size:8pt;">
                            <thead style="background:#eee;">
                                <tr>
                                    <th>Sl</th><th>Item of Assets</th>
                                    <th class="text-end">Cost</th><th class="text-end">WDV</th>
                                    <th>Qty per Register</th><th>Qty Found</th><th>Short/Excess</th>
                                    <th>Recommendation</th><th>Remarks</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="i" t-value="0"/>
                                <t t-foreach="doc.line_ids" t-as="l">
                                    <t t-set="i" t-value="i + 1"/>
                                    <tr>
                                        <td><t t-out="i"/></td>
                                        <td><t t-out="l.asset_id.name"/> (<t t-out="l.asset_id.mcb_asset_code or ''"/>)</td>
                                        <td class="text-end"><t t-out="'%.0f' % l.cost"/></td>
                                        <td class="text-end"><t t-out="'%.0f' % l.wdv"/></td>
                                        <td style="text-align:center;"><t t-out="l.qty_register"/></td>
                                        <td style="text-align:center;"><t t-out="l.qty_found"/></td>
                                        <td style="text-align:center;"><t t-out="l.diff"/></td>
                                        <td><t t-out="dict(l._fields['recommendation'].selection).get(l.recommendation)"/></td>
                                        <td><t t-out="l.remarks or ''"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        <table style="width:100%; margin-top:40px; text-align:center; font-size:9pt;">
                            <tr>
                                <td style="border-top:1px solid #000; width:30%;">Prepared By</td>
                                <td style="width:5%;"/>
                                <td style="border-top:1px solid #000; width:30%;">Reviewed By</td>
                                <td style="width:5%;"/>
                                <td style="border-top:1px solid #000; width:30%;">Approved By</td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- AST-007 asset ID label -->
    <record id="action_report_mcb_asset_label" model="ir.actions.report">
        <field name="name">Asset ID Label (AST-007)</field>
        <field name="model">account.asset</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">mcb_asset.report_mcb_asset_label</field>
        <field name="report_file">mcb_asset.report_mcb_asset_label</field>
        <field name="binding_model_id" ref="account_asset.model_account_asset"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_mcb_asset_label">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="page" style="page-break-after:always; border:2px solid #000; padding:12px; width:280px;">
                    <h4 style="margin:0;">Mukti Cox's Bazar</h4>
                    <p style="margin:4px 0; font-size:14pt;"><strong><t t-out="doc.mcb_asset_code or ''"/></strong></p>
                    <p style="margin:2px 0; font-size:9pt;">
                        <t t-out="doc.name"/><br/>
                        Project: <t t-out="doc.mcb_project_analytic_id.name or '-'"/><br/>
                        Purchased: <t t-out="doc.acquisition_date or ''"/>
                    </p>
                    <img t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('Code128', doc.mcb_asset_code or 'NA', 300, 60)"
                         style="width:100%;"/>
                </div>
            </t>
        </t>
    </template>
</odoo>
