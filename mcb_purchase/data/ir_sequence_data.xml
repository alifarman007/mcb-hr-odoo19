<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_mcb_order_po" model="ir.sequence">
            <field name="name">MCB Purchase Order</field>
            <field name="code">mcb.order.po</field>
            <field name="prefix">PO-%(year)s-</field>
            <field name="padding">4</field>
        </record>
        <record id="seq_mcb_order_co" model="ir.sequence">
            <field name="name">MCB Contract Order</field>
            <field name="code">mcb.order.co</field>
            <field name="prefix">CO-%(year)s-</field>
            <field name="padding">4</field>
        </record>
        <record id="seq_mcb_order_wo" model="ir.sequence">
            <field name="name">MCB Work Order</field>
            <field name="code">mcb.order.wo</field>
            <field name="prefix">WO-%(year)s-</field>
            <field name="padding">4</field>
        </record>
        <record id="seq_mcb_proc_checklist" model="ir.sequence">
            <field name="name">MCB Procurement Checklist</field>
            <field name="code">mcb.procurement.checklist</field>
            <field name="prefix">PCC/%(year)s/</field>
            <field name="padding">4</field>
        </record>
    </data>
    <data noupdate="1">
        <!-- Generic service product used when PR lines have no catalogue product -->
        <record id="product_mcb_generic" model="product.product">
            <field name="name">MCB Procurement Item (generic)</field>
            <field name="type">service</field>
            <field name="purchase_ok">True</field>
            <field name="sale_ok">False</field>
        </record>
    </data>
</odoo>
