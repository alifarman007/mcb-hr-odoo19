<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_form_mcb_onboarding" model="ir.ui.view">
        <field name="name">hr.employee.form.mcb.onboarding</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="mcb_hr_employee.view_employee_form_mcb_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='mcb_info']" position="inside">
                <group string="Onboarding (ONB-001 .. ONB-007)">
                    <group>
                        <field name="mcb_onboarding_plan_id" readonly="1"/>
                        <field name="mcb_onboarding_launched" readonly="1"/>
                    </group>
                    <group>
                        <field name="mcb_onboarding_progress" widget="progressbar"/>
                    </group>
                </group>
                <group>
                    <button name="action_mcb_launch_onboarding" type="object"
                            string="Launch / Re-Launch Onboarding Plan"
                            class="btn-primary"
                            groups="hr.group_hr_user"
                            invisible="mcb_onboarding_launched"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
