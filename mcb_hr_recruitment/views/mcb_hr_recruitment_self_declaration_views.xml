<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mcb_self_declaration_list" model="ir.ui.view">
        <field name="name">mcb.hr.recruitment.self.declaration.list</field>
        <field name="model">mcb.hr.recruitment.self.declaration</field>
        <field name="arch" type="xml">
            <list>
                <field name="requisition_id"/>
                <field name="rc_member_id"/>
                <field name="declaration_date"/>
                <field name="relationship_disclosed"/>
                <field name="signed" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_mcb_self_declaration_form" model="ir.ui.view">
        <field name="name">mcb.hr.recruitment.self.declaration.form</field>
        <field name="model">mcb.hr.recruitment.self.declaration</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="requisition_id"/>
                            <field name="rc_member_id"/>
                            <field name="declaration_date"/>
                        </group>
                        <group>
                            <field name="relationship_disclosed"/>
                            <field name="signed"/>
                        </group>
                    </group>
                    <field name="details" placeholder="Disclose details if any conflict of interest exists..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_mcb_self_declaration" model="ir.actions.act_window">
        <field name="name">RC Self-Declarations</field>
        <field name="res_model">mcb.hr.recruitment.self.declaration</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
