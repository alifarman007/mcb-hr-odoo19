<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mcb_recruitment_expenditure_list" model="ir.ui.view">
        <field name="name">mcb.hr.recruitment.expenditure.list</field>
        <field name="model">mcb.hr.recruitment.expenditure</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="requisition_id"/>
                <field name="date"/>
                <field name="total_amount"/>
                <field name="budget_amount"/>
                <field name="variance"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_mcb_recruitment_expenditure_form" model="ir.ui.view">
        <field name="name">mcb.hr.recruitment.expenditure.form</field>
        <field name="model">mcb.hr.recruitment.expenditure</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Submit"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary" invisible="state != 'submitted'"
                            groups="hr.group_hr_manager"/>
                    <button name="%(action_report_mcb_recruitment_topsheet)d"
                            type="action" string="Print Top Sheet"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="requisition_id"/>
                            <field name="date"/>
                            <field name="purpose"/>
                        </group>
                        <group>
                            <field name="budget_amount"/>
                            <field name="total_amount" readonly="1"/>
                            <field name="variance" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Voucher Lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="voucher_no"/>
                                    <field name="receiver"/>
                                    <field name="description"/>
                                    <field name="bill_amount"/>
                                    <field name="vat_amount"/>
                                    <field name="net_paid"/>
                                    <field name="analytic_code"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_mcb_recruitment_expenditure" model="ir.actions.act_window">
        <field name="name">Recruitment Expenditure</field>
        <field name="res_model">mcb.hr.recruitment.expenditure</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
