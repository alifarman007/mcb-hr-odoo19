<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- employees see their own advances/IOUs; finance sees all -->
        <record id="rule_mcb_advance_own" model="ir.rule">
            <field name="name">Advance: own records (employee)</field>
            <field name="model_id" ref="model_mcb_advance"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="rule_mcb_advance_finance" model="ir.rule">
            <field name="name">Advance: all (finance)</field>
            <field name="model_id" ref="model_mcb_advance"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('account.group_account_user')), (4, ref('mcb_account.group_mcb_audit'))]"/>
        </record>
        <record id="rule_mcb_iou_own" model="ir.rule">
            <field name="name">IOU: own records (employee)</field>
            <field name="model_id" ref="model_mcb_iou"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="rule_mcb_iou_finance" model="ir.rule">
            <field name="name">IOU: all (finance)</field>
            <field name="model_id" ref="model_mcb_iou"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('account.group_account_user')), (4, ref('mcb_account.group_mcb_audit'))]"/>
        </record>
    </data>
</odoo>
