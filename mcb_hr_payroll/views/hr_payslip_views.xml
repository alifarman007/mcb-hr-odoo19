<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_payslip_list_mcb" model="ir.ui.view">
        <field name="name">hr.payslip.list.mcb</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='employee_id']" position="after">
                <field name="mcb_grade_id" optional="show"/>
                <field name="mcb_donor" optional="show"/>
                <field name="mcb_analytic_code" optional="hide"/>
            </xpath>
        </field>
    </record>

</odoo>
