<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mcb_bin_card_list" model="ir.ui.view">
        <field name="name">mcb.bin.card.list</field>
        <field name="model">mcb.bin.card</field>
        <field name="arch" type="xml">
            <list>
                <field name="product_id"/>
                <field name="warehouse_id"/>
                <field name="location_id"/>
                <field name="purchase_order_id" optional="show"/>
                <field name="po_reference" optional="hide"/>
                <field name="lot_id" optional="hide"/>
                <field name="expiry_date" optional="show"
                       decoration-danger="expiry_date and expiry_date &lt; current_date"/>
                <field name="uom_id"/>
                <field name="total_in" sum="In"/>
                <field name="total_out" sum="Out"/>
                <field name="balance" sum="Balance"/>
            </list>
        </field>
    </record>

    <record id="view_mcb_bin_card_form" model="ir.ui.view">
        <field name="name">mcb.bin.card.form</field>
        <field name="model">mcb.bin.card</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group string="Card">
                            <field name="warehouse_id"/>
                            <field name="location_id"/>
                            <field name="page_no"/>
                        </group>
                        <group string="Item">
                            <field name="product_id"/>
                            <field name="uom_id"/>
                            <field name="purchase_order_id"/>
                            <field name="po_reference"/>
                            <field name="lot_id"/>
                            <field name="expiry_date"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="opening_balance"/>
                            <field name="total_in" readonly="1"/>
                            <field name="total_out" readonly="1"/>
                            <field name="balance" readonly="1"
                                   class="oe_subtotal_footer_separator"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Movements">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="party_name"/>
                                    <field name="doc_reference"/>
                                    <field name="qty_in" sum="In"/>
                                    <field name="qty_out" sum="Out"/>
                                    <field name="running_balance" readonly="1"/>
                                    <field name="recorded_by_id"/>
                                    <field name="remarks"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_mcb_bin_card_search" model="ir.ui.view">
        <field name="name">mcb.bin.card.search</field>
        <field name="model">mcb.bin.card</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="purchase_order_id"/>
                <field name="warehouse_id"/>
                <filter name="in_stock" string="With balance" domain="[('balance','&gt;',0)]"/>
                <filter name="expiring" string="Expired"
                        domain="[('expiry_date','&lt;',context_today().strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="g_wh" string="Warehouse" context="{'group_by':'warehouse_id'}"/>
                    <filter name="g_prod" string="Item" context="{'group_by':'product_id'}"/>
                    <filter name="g_po" string="PO" context="{'group_by':'purchase_order_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_mcb_bin_card" model="ir.actions.act_window">
        <field name="name">Bin / Stack Cards</field>
        <field name="res_model">mcb.bin.card</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
