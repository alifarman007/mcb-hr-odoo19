<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mcb_tax_challan_list" model="ir.ui.view">
        <field name="name">mcb.tax.challan.list</field>
        <field name="model">mcb.tax.challan</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="challan_type"/>
                <field name="challan_no"/>
                <field name="date"/>
                <field name="bank_name"/>
                <field name="branch_name"/>
                <field name="amount"/>
                <field name="state" widget="badge" decoration-success="state == 'deposited'"/>
            </list>
        </field>
    </record>

    <record id="view_mcb_tax_challan_form" model="ir.ui.view">
        <field name="name">mcb.tax.challan.form</field>
        <field name="model">mcb.tax.challan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_deposit" type="object" string="Mark Deposited"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_reset" type="object" string="Reset to Draft"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="challan_type"/>
                            <field name="challan_no"/>
                            <field name="date"/>
                            <field name="amount"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="bank_name"/>
                            <field name="branch_name"/>
                            <field name="period_date_from"/>
                            <field name="period_date_to"/>
                        </group>
                    </group>
                    <field name="move_ids" widget="many2many_tags"/>
                    <field name="note" placeholder="Notes..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_mcb_tax_challan" model="ir.actions.act_window">
        <field name="name">VAT / TDS Challans</field>
        <field name="res_model">mcb.tax.challan</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
