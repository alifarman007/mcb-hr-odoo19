<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mcb_salary_revision_wizard_form" model="ir.ui.view">
        <field name="name">mcb.hr.salary.revision.wizard.form</field>
        <field name="model">mcb.hr.salary.revision.wizard</field>
        <field name="arch" type="xml">
            <form string="Salary Revision / Promotion (PAY-002)">
                <group>
                    <group string="Employee">
                        <field name="employee_id"/>
                        <field name="revision_type"/>
                        <field name="effective_date"/>
                    </group>
                    <group string="Current">
                        <field name="current_grade_id"/>
                        <field name="current_wage"/>
                        <field name="current_job_id"/>
                        <field name="current_department_id"/>
                        <field name="current_project_code"/>
                        <field name="current_working_area"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                </group>
                <group string="New / After Revision">
                    <group>
                        <field name="new_grade_id"/>
                        <field name="new_wage"/>
                        <field name="new_job_id"/>
                        <field name="new_department_id"/>
                    </group>
                    <group>
                        <field name="new_project_code"/>
                        <field name="new_working_area"/>
                        <field name="new_contract_end_date"
                               invisible="revision_type not in ('extension','reappointment')"/>
                    </group>
                </group>
                <field name="reason" placeholder="Why the revision? (cited in the chatter log + letter footer)"/>
                <footer>
                    <button name="action_apply" type="object"
                            string="Apply &amp; Print Letter"
                            class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_mcb_salary_revision_wizard" model="ir.actions.act_window">
        <field name="name">Salary Revision / Promotion</field>
        <field name="res_model">mcb.hr.salary.revision.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="hr.model_hr_employee"/>
        <field name="binding_view_types">form</field>
    </record>

</odoo>
