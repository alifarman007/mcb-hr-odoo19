<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mcb_hr_grade_list" model="ir.ui.view">
        <field name="name">mcb.hr.grade.list</field>
        <field name="model">mcb.hr.grade</field>
        <field name="arch" type="xml">
            <list string="MCB Salary Grades">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="band"/>
                <field name="travel_entitlement"/>
                <field name="annual_leave_days"/>
                <field name="overtime_eligible"/>
            </list>
        </field>
    </record>

    <record id="view_mcb_hr_grade_form" model="ir.ui.view">
        <field name="name">mcb.hr.grade.form</field>
        <field name="model">mcb.hr.grade</field>
        <field name="arch" type="xml">
            <form string="MCB Grade">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="code"/>
                        <h1><field name="code"/></h1>
                        <field name="name" placeholder="Grade title (e.g. Senior Officer)"/>
                    </div>
                    <group>
                        <group>
                            <field name="band"/>
                            <field name="sequence"/>
                            <field name="annual_leave_days"/>
                        </group>
                        <group>
                            <field name="travel_entitlement"/>
                            <field name="overtime_eligible"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Description / scope of the grade..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mcb_hr_grade" model="ir.actions.act_window">
        <field name="name">MCB Grades</field>
        <field name="res_model">mcb.hr.grade</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Configure MCB salary grades (G1–G10)</p>
            <p>Grades drive per-diem rates, OT eligibility and leave entitlement across the HR modules.</p>
        </field>
    </record>

</odoo>
