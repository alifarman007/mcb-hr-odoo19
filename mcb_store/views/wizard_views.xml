<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mcb_store_register_wizard" model="ir.ui.view">
        <field name="name">mcb.store.register.wizard.form</field>
        <field name="model">mcb.store.register.wizard</field>
        <field name="arch" type="xml">
            <form string="Store Register / Monthly Stock">
                <group>
                    <group>
                        <field name="location_id"/>
                        <field name="product_id"/>
                    </group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="project_name"/>
                        <field name="funded_by"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_register" type="object"
                            string="Store Register (Annex-08)" class="btn-primary"/>
                    <button name="action_print_monthly" type="object"
                            string="Monthly Stock Report"/>
                    <button name="action_export_xlsx" type="object" string="Export XLSX"/>
                    <button special="cancel" string="Close"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_mcb_store_register_wizard" model="ir.actions.act_window">
        <field name="name">Store Register / Monthly Stock (Annex-08)</field>
        <field name="res_model">mcb.store.register.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
