<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_journal_form_mcb" model="ir.ui.view">
        <field name="name">account.journal.form.mcb</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="MCB Voucher Policy">
                    <field name="mcb_require_approval"/>
                    <field name="mcb_petty_cash_limit" invisible="type != 'cash'"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
