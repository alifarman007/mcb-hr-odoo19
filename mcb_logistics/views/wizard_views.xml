<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mcb_monthly_stock_wizard" model="ir.ui.view">
        <field name="name">mcb.monthly.stock.wizard.form</field>
        <field name="model">mcb.monthly.stock.wizard</field>
        <field name="arch" type="xml">
            <form string="Monthly Stock Report">
                <group>
                    <group>
                        <field name="month_date"/>
                        <field name="warehouse_id"/>
                    </group>
                    <group>
                        <field name="project_id"/>
                        <field name="donor"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_pdf" type="object" string="Print PDF"
                            class="btn-primary"/>
                    <button name="action_export_xlsx" type="object" string="Export XLSX"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_mcb_monthly_stock_wizard" model="ir.actions.act_window">
        <field name="name">Monthly Stock Report</field>
        <field name="res_model">mcb.monthly.stock.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
