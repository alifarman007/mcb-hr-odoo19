<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_mcb_requisition" model="ir.sequence">
            <field name="name">MCB Staff Requisition</field>
            <field name="code">mcb.hr.staff.requisition</field>
            <field name="prefix">REQ/%(year)s/</field>
            <field name="padding">4</field>
        </record>
        <record id="seq_mcb_admit_card" model="ir.sequence">
            <field name="name">MCB Admit Card</field>
            <field name="code">mcb.hr.admit.card</field>
            <field name="prefix"></field>
            <field name="padding">3</field>
        </record>
        <record id="seq_mcb_recruitment_expenditure" model="ir.sequence">
            <field name="name">MCB Recruitment Expenditure</field>
            <field name="code">mcb.hr.recruitment.expenditure</field>
            <field name="prefix">REXP/%(year)s/</field>
            <field name="padding">4</field>
        </record>
    </data>
</odoo>
