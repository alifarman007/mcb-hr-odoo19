<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- T38 (client feedback): Audit department — all modules, view only -->
        <record id="group_mcb_audit" model="res.groups">
            <field name="name">MCB Audit Department (View Only)</field>
            <field name="privilege_id" ref="mcb_hr_employee.privilege_mcb_hr_role"/>
            <field name="comment">Read-only access across MCB models and accounting for external/internal audit (PER-004).</field>
            <field name="implied_ids" eval="[(4, ref('account.group_account_readonly'))]"/>
        </record>

        <!-- Finance manager convenience group mapping (T38) -->
        <record id="group_mcb_finance_manager" model="res.groups">
            <field name="name">MCB Finance Manager</field>
            <field name="privilege_id" ref="mcb_hr_employee.privilege_mcb_hr_role"/>
            <field name="comment">Voucher approval, bank reconciliation, donor reports, challans.</field>
            <field name="implied_ids" eval="[(4, ref('account.group_account_manager'))]"/>
        </record>

    </data>
</odoo>
