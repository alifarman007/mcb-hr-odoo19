<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mcb_bank_recon_wizard" model="ir.ui.view">
        <field name="name">mcb.bank.recon.wizard.form</field>
        <field name="model">mcb.bank.recon.wizard</field>
        <field name="arch" type="xml">
            <form string="Bank Reconciliation Statement (Annexure-17)">
                <group>
                    <field name="journal_id"/>
                    <field name="date_to"/>
                    <field name="statement_balance"/>
                    <field name="currency_id" invisible="1"/>
                </group>
                <footer>
                    <button name="action_print_pdf" type="object" string="Print PDF" class="btn-primary"/>
                    <button name="action_export_xlsx" type="object" string="Export XLSX"/>
                    <button special="cancel" string="Close"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_mcb_bank_recon_wizard" model="ir.actions.act_window">
        <field name="name">Bank Reconciliation Statement (Annexure-17)</field>
        <field name="res_model">mcb.bank.recon.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

