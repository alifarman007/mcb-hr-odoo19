<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_mcb_vehicle_expiry" model="ir.cron">
            <field name="name">MCB: Vehicle insurance/fitness expiry alert (VEH-004)</field>
            <field name="model_id" ref="fleet.model_fleet_vehicle"/>
            <field name="state">code</field>
            <field name="code">model._cron_mcb_expiry_alert()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
        <record id="seq_mcb_movement" model="ir.sequence">
            <field name="name">MCB Movement Register</field>
            <field name="code">mcb.movement.register</field>
            <field name="prefix">MOV/%(year)s/</field>
            <field name="padding">4</field>
        </record>
    </data>
</odoo>
