<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mcb_assignment_list" model="ir.ui.view">
        <field name="name">mcb.project.assignment.list</field>
        <field name="model">mcb.project.assignment</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="employee_id"/>
                <field name="project_id"/>
                <field name="analytic_account_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="percent"/>
            </list>
        </field>
    </record>
    <record id="action_mcb_assignment" model="ir.actions.act_window">
        <field name="name">Staff Assignments (% Time)</field>
        <field name="res_model">mcb.project.assignment</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
