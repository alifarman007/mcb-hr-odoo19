<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mcb_budget_revision_list" model="ir.ui.view">
        <field name="name">mcb.budget.revision.list</field>
        <field name="model">mcb.budget.revision</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="budget_id"/>
                <field name="line_id"/>
                <field name="old_amount"/>
                <field name="new_amount"/>
                <field name="delta_pct"/>
                <field name="requires_ce"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_mcb_budget_revision_form" model="ir.ui.view">
        <field name="name">mcb.budget.revision.form</field>
        <field name="model">mcb.budget.revision</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            invisible="state != 'submitted'" groups="account.group_account_manager"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state != 'submitted'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="budget_id"/>
                            <field name="line_id"/>
                        </group>
                        <group>
                            <field name="old_amount"/>
                            <field name="new_amount"/>
                            <field name="delta_pct" readonly="1"/>
                            <field name="requires_ce" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="reason" placeholder="Justification for the reallocation (BUD-005)..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_mcb_budget_revision" model="ir.actions.act_window">
        <field name="name">Budget Revisions (BUD-005)</field>
        <field name="res_model">mcb.budget.revision</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
