<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_mcb" model="ir.ui.view">
        <field name="name">account.payment.form.mcb</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="MCB">
                    <field name="mcb_receipt_no" readonly="1"/>
                    <field name="mcb_amount_in_words" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
