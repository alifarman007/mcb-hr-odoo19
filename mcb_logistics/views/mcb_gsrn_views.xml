<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mcb_gsrn_list" model="ir.ui.view">
        <field name="name">mcb.gsrn.list</field>
        <field name="model">mcb.gsrn</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date"/>
                <field name="source_type"/>
                <field name="partner_id"/>
                <field name="purchase_order_id" optional="show"/>
                <field name="donor" optional="hide"/>
                <field name="warehouse_id"/>
                <field name="amount_total" sum="Total"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'posted'"
                       decoration-info="state == 'received'"/>
            </list>
        </field>
    </record>

    <record id="view_mcb_gsrn_form" model="ir.ui.view">
        <field name="name">mcb.gsrn.form</field>
        <field name="model">mcb.gsrn</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_receive" type="object" string="Receive"
                            class="btn-primary" invisible="state != 'draft'"
                            groups="mcb_logistics.group_mcb_storekeeper"/>
                    <button name="action_post" type="object" string="Post to Stock"
                            class="btn-primary" invisible="state != 'received'"
                            groups="mcb_logistics.group_mcb_storekeeper"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('posted', 'cancelled')"/>
                    <button name="action_draft" type="object" string="Reset to Draft"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,received,posted"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_picking" type="object"
                                class="oe_stat_button" icon="fa-truck"
                                invisible="not picking_id">
                            <span class="o_stat_text">Stock Receipt</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Supplier">
                            <field name="source_type"/>
                            <field name="partner_id"
                                   invisible="source_type == 'in_kind'"/>
                            <field name="donor"
                                   invisible="source_type != 'in_kind'"/>
                            <field name="supplier_challan_no"/>
                            <field name="supplier_challan_date"/>
                        </group>
                        <group string="Mukti Cox's Bazar">
                            <field name="warehouse_id"/>
                            <field name="location_id"/>
                            <field name="purchase_order_id"
                                   invisible="source_type != 'purchase'"
                                   required="source_type == 'purchase'"/>
                            <field name="reference_no"
                                   invisible="source_type == 'purchase'"/>
                            <field name="date"/>
                            <field name="pad_serial"/>
                        </group>
                    </group>
                    <group>
                        <group string="Charged To">
                            <field name="project_id"/>
                            <field name="analytic_account_id"/>
                        </group>
                        <group string="Quality Inspection">
                            <field name="inspection_result"/>
                            <field name="inspection_remarks"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Items Received">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="description"/>
                                    <field name="uom_id"/>
                                    <field name="lot_id" optional="hide"/>
                                    <field name="qty_ordered"/>
                                    <field name="qty_received"/>
                                    <field name="qty_rejected"/>
                                    <field name="qty_accepted" readonly="1"/>
                                    <field name="unit_cost"/>
                                    <field name="amount" readonly="1" sum="Total"/>
                                    <field name="remarks" optional="show"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="amount_total"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                        </page>
                        <page string="Signatures &amp; Remarks">
                            <group>
                                <group string="Delivered By (vendor side)">
                                    <field name="delivered_by_name"/>
                                    <field name="delivered_by_date"/>
                                </group>
                                <group string="Recipient">
                                    <field name="recipient_id"/>
                                    <field name="recipient_designation"/>
                                </group>
                            </group>
                            <field name="remarks" placeholder="Remarks..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_mcb_gsrn_search" model="ir.ui.view">
        <field name="name">mcb.gsrn.search</field>
        <field name="model">mcb.gsrn</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="purchase_order_id"/>
                <filter name="posted" string="Posted" domain="[('state','=','posted')]"/>
                <filter name="pending" string="Not yet in stock"
                        domain="[('state','in',('draft','received'))]"/>
                <filter name="in_kind" string="In-kind donations"
                        domain="[('source_type','=','in_kind')]"/>
                <group>
                    <filter name="g_wh" string="Warehouse"
                            context="{'group_by': 'warehouse_id'}"/>
                    <filter name="g_src" string="Source"
                            context="{'group_by': 'source_type'}"/>
                    <filter name="g_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_mcb_gsrn" model="ir.actions.act_window">
        <field name="name">Goods &amp; Service Received Notes</field>
        <field name="res_model">mcb.gsrn</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
