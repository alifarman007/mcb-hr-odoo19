<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_mcb_advance" model="ir.actions.report">
        <field name="name">Advance Request (Annexure-18)</field>
        <field name="model">mcb.advance</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">mcb_cash_advance.report_mcb_advance</field>
        <field name="report_file">mcb_cash_advance.report_mcb_advance</field>
        <field name="binding_model_id" ref="model_mcb_advance"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_mcb_advance">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div style="text-align:center;">
                            <h3 style="margin:0;">Mukti Cox's Bazar</h3>
                            <p style="margin:2px 0;">Head Office, Goldighirpar, Cox's Bazar</p>
                            <h4>Advance Request (<t t-out="doc.name"/>)</h4>
                        </div>
                        <p>
                            <strong>Project/Office:</strong> <t t-out="doc.project_analytic_id.name or ''"/> ·
                            <strong>Funded By:</strong> <t t-out="doc.funded_by or ''"/> ·
                            <strong>Date:</strong> <t t-out="doc.required_date"/>
                        </p>
                        <p>
                            <strong>Sub: Advance Request.</strong><br/>
                            Name of Activity: <strong><t t-out="doc.activity_name"/></strong><br/>
                            Accounts Head: <t t-out="doc.account_id.display_name or ''"/> ·
                            Advance Requirement Date: <t t-out="doc.required_date"/><br/>
                            I am solely responsible for this advance if any unfair means (Lost/Theft)
                            happens. The receiving amount will be adjusted within 05 (five) working
                            days after the completion of the event.
                        </p>
                        <table class="table table-sm table-bordered" style="font-size:9pt;">
                            <thead style="background:#eee;">
                                <tr><th>Sl</th><th>Particulars</th><th class="text-end">Amount</th><th>Remarks</th></tr>
                            </thead>
                            <tbody>
                                <t t-set="i" t-value="0"/>
                                <t t-foreach="doc.line_ids" t-as="l">
                                    <t t-set="i" t-value="i + 1"/>
                                    <tr>
                                        <td><t t-out="i"/></td>
                                        <td><t t-out="l.name"/></td>
                                        <td class="text-end"><t t-out="'%.2f' % l.amount"/></td>
                                        <td><t t-out="l.remarks or ''"/></td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr style="background:#eee;">
                                    <th colspan="2">Total</th>
                                    <th class="text-end"><t t-out="'%.2f' % doc.amount"/></th><th/>
                                </tr>
                            </tfoot>
                        </table>
                        <p><strong>Amount in words:</strong> <t t-out="doc.amount_in_words or ''"/></p>
                        <p><strong>Finance Comments:</strong> <t t-out="doc.finance_comment or '____________________'"/></p>
                        <table style="width:100%; margin-top:45px; text-align:center; font-size:9pt;">
                            <tr>
                                <td style="border-top:1px solid #000; width:22%;">Applicant<br/><t t-out="doc.employee_id.name"/></td>
                                <td style="width:4%;"/>
                                <td style="border-top:1px solid #000; width:22%;">Finance</td>
                                <td style="width:4%;"/>
                                <td style="border-top:1px solid #000; width:22%;">Reviewed By</td>
                                <td style="width:4%;"/>
                                <td style="border-top:1px solid #000; width:22%;">Approved By</td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_mcb_adv_adjust" model="ir.actions.report">
        <field name="name">Advance Adjustment (Annexure-19)</field>
        <field name="model">mcb.advance.adjustment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">mcb_cash_advance.report_mcb_adv_adjust</field>
        <field name="report_file">mcb_cash_advance.report_mcb_adv_adjust</field>
        <field name="binding_model_id" ref="model_mcb_advance_adjustment"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_mcb_adv_adjust">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div style="text-align:center;">
                            <h3 style="margin:0;">Mukti Cox's Bazar</h3>
                            <h4>Advance Adjustment Form (<t t-out="doc.name"/>)</h4>
                        </div>
                        <p>
                            <strong>Name:</strong> <t t-out="doc.employee_id.name"/> ·
                            <strong>Activity:</strong> <t t-out="doc.advance_id.activity_name"/> ·
                            <strong>Date of adjustment:</strong> <t t-out="doc.date_adjustment"/><br/>
                            <strong>Amount Received:</strong> <t t-out="'%.2f' % doc.amount_received"/> ·
                            <strong>Ref. Payment Voucher:</strong>
                            <t t-out="doc.advance_id.payment_move_id.mcb_voucher_no or doc.advance_id.payment_move_id.name or ''"/> ·
                            <strong>Claimable/Refundable:</strong> <t t-out="'%.2f' % doc.amount_diff"/>
                        </p>
                        <table class="table table-sm table-bordered" style="font-size:9pt;">
                            <thead style="background:#eee;">
                                <tr><th>Sl</th><th>Particulars</th><th>Accounts Code</th>
                                    <th class="text-end">Amount BDT</th><th>Remarks</th></tr>
                            </thead>
                            <tbody>
                                <t t-set="i" t-value="0"/>
                                <t t-foreach="doc.line_ids" t-as="l">
                                    <t t-set="i" t-value="i + 1"/>
                                    <tr>
                                        <td><t t-out="i"/></td>
                                        <td><t t-out="l.name"/></td>
                                        <td><t t-out="l.account_id.code"/></td>
                                        <td class="text-end"><t t-out="'%.2f' % l.amount"/></td>
                                        <td><t t-out="l.remarks or ''"/></td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr style="background:#eee;">
                                    <th colspan="3">Total Expenditure</th>
                                    <th class="text-end"><t t-out="'%.2f' % doc.amount_spent"/></th><th/>
                                </tr>
                            </tfoot>
                        </table>
                        <table style="width:100%; margin-top:45px; text-align:center; font-size:9pt;">
                            <tr>
                                <td style="border-top:1px solid #000; width:22%;">Advance Receiver</td>
                                <td style="width:4%;"/>
                                <td style="border-top:1px solid #000; width:22%;">Checked By</td>
                                <td style="width:4%;"/>
                                <td style="border-top:1px solid #000; width:22%;">Reviewed By</td>
                                <td style="width:4%;"/>
                                <td style="border-top:1px solid #000; width:22%;">Approved By</td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_mcb_iou" model="ir.actions.report">
        <field name="name">IOU Form (Annexure-13)</field>
        <field name="model">mcb.iou</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">mcb_cash_advance.report_mcb_iou</field>
        <field name="report_file">mcb_cash_advance.report_mcb_iou</field>
        <field name="binding_model_id" ref="model_mcb_iou"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_mcb_iou">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div style="text-align:center;">
                            <h3 style="margin:0;">Mukti Cox's Bazar</h3>
                            <h4>IOU Form (<t t-out="doc.name"/>)</h4>
                        </div>
                        <p>
                            <strong>Project/Office:</strong> <t t-out="doc.project_analytic_id.name or ''"/> ·
                            <strong>Funded By:</strong> <t t-out="doc.funded_by or ''"/><br/>
                            <strong>Receiving Date:</strong> <t t-out="doc.receiving_date or '__________'"/> ·
                            <strong>Adjustment Date:</strong> <t t-out="doc.adjust_deadline or '__________'"/><br/>
                            <strong>Amount BDT:</strong> <t t-out="'%.2f' % doc.amount"/><br/>
                            <strong>Amount in words:</strong> <t t-out="doc.amount_in_words or ''"/><br/>
                            <strong>Purpose of IOU:</strong> <t t-out="doc.purpose"/>
                        </p>
                        <p>
                            I will adjust this IOU within <t t-out="doc.days_to_adjust"/> working days.
                            I hereby confirm that I have no previous outstanding IOU.
                        </p>
                        <table style="width:100%; margin-top:45px; text-align:center; font-size:9pt;">
                            <tr>
                                <td style="border-top:1px solid #000; width:22%;">Signature<br/><t t-out="doc.employee_id.name"/></td>
                                <td style="width:4%;"/>
                                <td style="border-top:1px solid #000; width:22%;">Finance</td>
                                <td style="width:4%;"/>
                                <td style="border-top:1px solid #000; width:22%;">Reviewed By</td>
                                <td style="width:4%;"/>
                                <td style="border-top:1px solid #000; width:22%;">Approved By</td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
