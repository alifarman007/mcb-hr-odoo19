<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- The per-financial-year sequences (GSRN-2627-0001 etc) are created on first
             use by mcb.fy.mixin. These are the fallbacks and the operation type. -->
        <record id="seq_mcb_gsrn" model="ir.sequence">
            <field name="name">MCB Goods &amp; Service Received Note</field>
            <field name="code">mcb.gsrn</field>
            <field name="prefix">GSRN-</field>
            <field name="padding">4</field>
        </record>
        <record id="seq_mcb_challan" model="ir.sequence">
            <field name="name">MCB Materials Supply Note / Challan</field>
            <field name="code">mcb.challan</field>
            <field name="prefix">CHL-</field>
            <field name="padding">4</field>
        </record>
        <record id="seq_mcb_stock_verification" model="ir.sequence">
            <field name="name">MCB Physical Stock Verification</field>
            <field name="code">mcb.stock.verification</field>
            <field name="prefix">PIV-</field>
            <field name="padding">3</field>
        </record>
        <record id="seq_mcb_stock_disposal" model="ir.sequence">
            <field name="name">MCB Stock Disposal Request</field>
            <field name="code">mcb.stock.disposal</field>
            <field name="prefix">DSP-</field>
            <field name="padding">3</field>
        </record>
    </data>
</odoo>
