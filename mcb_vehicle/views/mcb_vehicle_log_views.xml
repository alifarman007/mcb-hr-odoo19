<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mcb_vehicle_log_list" model="ir.ui.view">
        <field name="name">mcb.vehicle.log.list</field>
        <field name="model">mcb.vehicle.log</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="vehicle_id"/>
                <field name="date"/>
                <field name="employee_id"/>
                <field name="driver_name" optional="hide"/>
                <field name="purpose"/>
                <field name="location_from"/>
                <field name="location_to"/>
                <field name="time_start" widget="float_time"/>
                <field name="time_end" widget="float_time"/>
                <field name="total_time" widget="float_time"/>
                <field name="meter_start"/>
                <field name="meter_end"/>
                <field name="km_run"/>
                <field name="fuel_litre"/>
                <field name="fuel_cost" optional="show"/>
                <field name="lub" optional="hide"/>
                <field name="project_id" optional="show"/>
                <field name="remarks" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_mcb_vehicle_log_pivot" model="ir.ui.view">
        <field name="name">mcb.vehicle.log.pivot</field>
        <field name="model">mcb.vehicle.log</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="vehicle_id" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="km_run" type="measure"/>
                <field name="fuel_litre" type="measure"/>
                <field name="fuel_cost" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_mcb_vehicle_log" model="ir.actions.act_window">
        <field name="name">Vehicle Log Book (Annexure-10)</field>
        <field name="res_model">mcb.vehicle.log</field>
        <field name="view_mode">list,pivot</field>
    </record>
</odoo>
