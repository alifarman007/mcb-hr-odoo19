<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mcb_working_budget_list" model="ir.ui.view">
        <field name="name">mcb.working.budget.list</field>
        <field name="model">mcb.working.budget</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="activity_name"/>
                <field name="budget_id"/>
                <field name="analytic_account_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="amount_total"/>
                <field name="amount_consumed"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'"/>
            </list>
        </field>
    </record>

    <record id="view_mcb_working_budget_form" model="ir.ui.view">
        <field name="name">mcb.working.budget.form</field>
        <field name="model">mcb.working.budget</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_check" type="object" string="Check" class="btn-primary"
                            invisible="state != 'draft'" groups="account.group_account_user"/>
                    <button name="action_review" type="object" string="Review"
                            invisible="state != 'checked'" groups="account.group_account_user"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            invisible="state != 'reviewed'" groups="account.group_account_manager"/>
                    <button name="%(action_report_mcb_working_budget)d" type="action"
                            string="Print (Annexure-26)"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="budget_id"/>
                            <field name="analytic_account_id"/>
                            <field name="activity_name"/>
                            <field name="account_id"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="amount_total" readonly="1"/>
                            <field name="amount_consumed" readonly="1"/>
                            <field name="amount_in_words" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="unit_desc"/>
                            <field name="unit"/>
                            <field name="times"/>
                            <field name="unit_cost"/>
                            <field name="amount"/>
                            <field name="remarks"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_mcb_working_budget" model="ir.actions.act_window">
        <field name="name">Working Budgets (Annexure-26)</field>
        <field name="res_model">mcb.working.budget</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
