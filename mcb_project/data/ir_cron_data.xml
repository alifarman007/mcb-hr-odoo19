<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_mcb_milestone_alert" model="ir.cron">
            <field name="name">MCB: Milestone delay alerts (MON-003)</field>
            <field name="model_id" ref="project.model_project_milestone"/>
            <field name="state">code</field>
            <field name="code">model._cron_mcb_milestone_alert()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
        <record id="cron_mcb_ts_autofill" model="ir.cron">
            <field name="name">MCB: Timesheet auto-fill from attendance (TMS-003)</field>
            <field name="model_id" ref="model_mcb_project_assignment"/>
            <field name="state">code</field>
            <field name="code">model._cron_autofill_timesheets()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
