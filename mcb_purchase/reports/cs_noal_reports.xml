<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- CS-008 Comparative Statement PDF -->
    <record id="action_report_mcb_cs" model="ir.actions.report">
        <field name="name">Comparative Statement (CS-008)</field>
        <field name="model">mcb.comparative.statement</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">mcb_purchase.report_mcb_cs</field>
        <field name="report_file">mcb_purchase.report_mcb_cs</field>
        <field name="binding_model_id" ref="model_mcb_comparative_statement"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_mcb_cs">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div style="text-align:center;">
                            <h3 style="margin:0;">Mukti Cox's Bazar</h3>
                            <h4>Comparative Statement — <t t-out="doc.name"/></h4>
                        </div>
                        <p style="font-size:9pt;">
                            <strong>Project:</strong> <t t-out="doc.project_analytic_id.name or ''"/> ·
                            <strong>Donor:</strong> <t t-out="doc.donor or ''"/> ·
                            <strong>PR Ref:</strong> <t t-out="doc.request_id.name"/><br/>
                            <strong>Circular/Tender Date:</strong> <t t-out="doc.circular_date or ''"/> ·
                            <strong>Opening:</strong> <t t-out="doc.opening_date or ''"/> ·
                            <strong>Evaluation:</strong> <t t-out="doc.evaluation_date or ''"/>
                        </p>
                        <h5>Items (PR)</h5>
                        <table class="table table-sm table-bordered" style="font-size:8.5pt;">
                            <thead style="background:#eee;">
                                <tr><th>SL</th><th>Items Name</th><th>Description</th>
                                    <th>M.Unit</th><th class="text-end">Qty</th></tr>
                            </thead>
                            <tbody>
                                <t t-set="i" t-value="0"/>
                                <t t-foreach="doc.request_id.line_ids" t-as="l">
                                    <t t-set="i" t-value="i + 1"/>
                                    <tr>
                                        <td><t t-out="i"/></td>
                                        <td><t t-out="l.name"/></td>
                                        <td><t t-out="l.specification or ''"/></td>
                                        <td><t t-out="l.uom_id.name or ''"/></td>
                                        <td class="text-end"><t t-out="l.quantity"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        <h5>Supplier Comparison (technically qualified only — CS-005)</h5>
                        <table class="table table-sm table-bordered" style="font-size:9pt;">
                            <thead style="background:#eee;">
                                <tr><th>Supplier</th><th>RFQ</th>
                                    <th class="text-end">Grand Total</th>
                                    <th>Bidding Position</th></tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.vendor_line_ids" t-as="v">
                                    <tr>
                                        <td><t t-out="v.vendor_id.name"/></td>
                                        <td><t t-out="v.order_id.name or ''"/></td>
                                        <td class="text-end"><t t-out="'%.2f' % v.grand_total"/></td>
                                        <td>
                                            <t t-if="v.position == 1">1st Lowest</t>
                                            <t t-elif="v.position == 2">2nd Lowest</t>
                                            <t t-elif="v.position == 3">3rd Lowest</t>
                                            <t t-else=""><t t-out="v.position"/>th</t>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        <h5>Procurement Committee Comment (CS-006)</h5>
                        <div style="border:1px solid #999; min-height:70px; padding:6px; font-size:9pt;">
                            <t t-out="doc.pc_comment or ''"/>
                        </div>
                        <table style="width:100%; margin-top:40px; text-align:center; font-size:9pt;">
                            <tr>
                                <td style="border-top:1px solid #000; width:22%;">PC Member</td>
                                <td style="width:4%;"/>
                                <td style="border-top:1px solid #000; width:22%;">PC Member</td>
                                <td style="width:4%;"/>
                                <td style="border-top:1px solid #000; width:22%;">PC In-charge</td>
                                <td style="width:4%;"/>
                                <td style="border-top:1px solid #000; width:22%;">Chief Executive</td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- NOAL letter -->
    <record id="action_report_mcb_noal" model="ir.actions.report">
        <field name="name">Notification of Award Letter</field>
        <field name="model">mcb.noal</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">mcb_purchase.report_mcb_noal</field>
        <field name="report_file">mcb_purchase.report_mcb_noal</field>
        <field name="binding_model_id" ref="model_mcb_noal"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_mcb_noal">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page" style="font-size:10pt;">
                        <p style="float:left;"><strong>Ref:</strong> <t t-out="doc.name"/></p>
                        <p style="text-align:right;"><strong>Date:</strong> <t t-out="doc.date"/></p>
                        <div style="clear:both;"/>
                        <p>To<br/>
                            <strong><t t-out="doc.vendor_id.name"/></strong><br/>
                            <t t-out="doc.vendor_address or ''"/>
                        </p>
                        <h4 style="text-align:center;">Subject: Notification of Award Letter (NOAL)</h4>
                        <p>Dear Sir/Madam,</p>
                        <p>
                            We are pleased to notify you that your bid against
                            <strong><t t-out="doc.order_id.mcb_pr_id.name or doc.order_id.name"/></strong>
                            has been accepted by Mukti Cox's Bazar for the contract price of
                            <strong>BDT <t t-out="'{:,.2f}'.format(doc.contract_price)"/></strong>
                            (<t t-out="doc.contract_price_words or ''"/>).
                        </p>
                        <p>
                            You are requested to furnish a Performance Security of
                            <strong>BDT <t t-out="'{:,.2f}'.format(doc.performance_security_amount)"/></strong>
                            (<t t-out="doc.performance_security_pct"/>% of the contract price) within the
                            period stated in the tender documents, failing which the award may be annulled.
                        </p>
                        <p>Please acknowledge receipt of this notification.</p>
                        <p style="margin-top:50px;">
                            (Authorised Signatory)<br/>
                            Procurement Manager / Chief Executive<br/>
                            Mukti Cox's Bazar
                        </p>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- Opening sheet -->
    <record id="action_report_mcb_opening_sheet" model="ir.actions.report">
        <field name="name">Tender/RFQ Opening Sheet</field>
        <field name="model">mcb.opening.sheet</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">mcb_purchase.report_mcb_opening_sheet</field>
        <field name="report_file">mcb_purchase.report_mcb_opening_sheet</field>
        <field name="binding_model_id" ref="model_mcb_opening_sheet"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_mcb_opening_sheet">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div style="text-align:center;">
                            <h3 style="margin:0;">Mukti Cox's Bazar</h3>
                            <h4>RFQ / Tender Opening Sheet — <t t-out="doc.name"/></h4>
                        </div>
                        <p>
                            <strong>PR:</strong> <t t-out="doc.request_id.name"/> ·
                            <strong>Opening:</strong> <t t-out="doc.opening_datetime"/><br/>
                            <strong>Members Present:</strong>
                            <t t-out="', '.join(doc.member_ids.mapped('name'))"/>
                        </p>
                        <table class="table table-sm table-bordered" style="font-size:9pt;">
                            <thead style="background:#eee;">
                                <tr><th>Sl</th><th>Bidder</th><th class="text-end">Quoted Total</th>
                                    <th>Security Submitted</th><th>Remarks</th></tr>
                            </thead>
                            <tbody>
                                <t t-set="i" t-value="0"/>
                                <t t-foreach="doc.line_ids" t-as="l">
                                    <t t-set="i" t-value="i + 1"/>
                                    <tr>
                                        <td><t t-out="i"/></td>
                                        <td><t t-out="l.vendor_id.name"/></td>
                                        <td class="text-end"><t t-out="'%.2f' % l.quoted_total"/></td>
                                        <td style="text-align:center;"><t t-if="l.security_submitted">Yes</t><t t-else="">No</t></td>
                                        <td><t t-out="l.remarks or ''"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        <table style="width:100%; margin-top:45px; text-align:center; font-size:9pt;">
                            <tr>
                                <td style="border-top:1px solid #000; width:30%;">Member</td>
                                <td style="width:5%;"/>
                                <td style="border-top:1px solid #000; width:30%;">Member</td>
                                <td style="width:5%;"/>
                                <td style="border-top:1px solid #000; width:30%;">Chairperson</td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- Technical analysis -->
    <record id="action_report_mcb_ta" model="ir.actions.report">
        <field name="name">Technical Analysis (TA)</field>
        <field name="model">mcb.technical.analysis</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">mcb_purchase.report_mcb_ta</field>
        <field name="report_file">mcb_purchase.report_mcb_ta</field>
        <field name="binding_model_id" ref="model_mcb_technical_analysis"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_mcb_ta">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div style="text-align:center;">
                            <h3 style="margin:0;">Mukti Cox's Bazar</h3>
                            <h4>Technical Analysis Sheet (<t t-out="doc.ta_type.upper()"/>) — <t t-out="doc.name"/></h4>
                        </div>
                        <p><strong>PR:</strong> <t t-out="doc.request_id.name"/></p>
                        <table class="table table-sm table-bordered" style="font-size:9pt;">
                            <thead style="background:#eee;">
                                <tr><th>Vendor</th><th>Meets Specs</th><th>Meets Delivery</th>
                                    <th>Result</th><th>Remarks</th></tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.line_ids" t-as="l">
                                    <tr>
                                        <td><t t-out="l.vendor_id.name"/></td>
                                        <td style="text-align:center;"><t t-if="l.spec_compliance">Yes</t><t t-else="">No</t></td>
                                        <td style="text-align:center;"><t t-if="l.delivery_compliance">Yes</t><t t-else="">No</t></td>
                                        <td><strong t-out="l.result.upper()"/></td>
                                        <td><t t-out="l.remarks or ''"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- Evaluation -->
    <record id="action_report_mcb_eval" model="ir.actions.report">
        <field name="name">Vendor Evaluation Report</field>
        <field name="model">mcb.vendor.evaluation</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">mcb_purchase.report_mcb_eval</field>
        <field name="report_file">mcb_purchase.report_mcb_eval</field>
        <field name="binding_model_id" ref="model_mcb_vendor_evaluation"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_mcb_eval">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div style="text-align:center;">
                            <h3 style="margin:0;">Mukti Cox's Bazar</h3>
                            <h4>Evaluation Report (<t t-out="doc.eval_type.upper()"/>) — <t t-out="doc.name"/></h4>
                        </div>
                        <p>
                            <strong>PR:</strong> <t t-out="doc.request_id.name"/> ·
                            <strong>CS:</strong> <t t-out="doc.cs_id.name or ''"/>
                        </p>
                        <table class="table table-sm table-bordered" style="font-size:9pt;">
                            <thead style="background:#eee;">
                                <tr><th>Vendor</th><th class="text-end">Price (40)</th>
                                    <th class="text-end">Quality (30)</th>
                                    <th class="text-end">Delivery (15)</th>
                                    <th class="text-end">Experience (15)</th>
                                    <th class="text-end">Total (100)</th></tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.line_ids" t-as="l">
                                    <tr>
                                        <td><t t-out="l.vendor_id.name"/></td>
                                        <td class="text-end"><t t-out="l.price_score"/></td>
                                        <td class="text-end"><t t-out="l.quality_score"/></td>
                                        <td class="text-end"><t t-out="l.delivery_score"/></td>
                                        <td class="text-end"><t t-out="l.experience_score"/></td>
                                        <td class="text-end"><strong t-out="l.total_score"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        <p><strong>Recommended Vendor:</strong>
                            <t t-out="doc.recommended_vendor_id.name or ''"/></p>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- Annexure-29 procurement checklist -->
    <record id="action_report_mcb_proc_checklist" model="ir.actions.report">
        <field name="name">Procurement Checklist (Annexure-29)</field>
        <field name="model">mcb.procurement.checklist</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">mcb_purchase.report_mcb_proc_checklist</field>
        <field name="report_file">mcb_purchase.report_mcb_proc_checklist</field>
        <field name="binding_model_id" ref="model_mcb_procurement_checklist"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_mcb_proc_checklist">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div style="text-align:center;">
                            <h3 style="margin:0;">Mukti Cox's Bazar</h3>
                            <h4>Checklist for Procurement Procedures</h4>
                        </div>
                        <p>
                            <strong>PR No.:</strong> <t t-out="doc.request_id.name"/> ·
                            <strong>PO No.:</strong>
                            <t t-out="doc.order_id.mcb_order_ref or doc.order_id.name or ''"/>
                        </p>
                        <table class="table table-sm table-bordered" style="font-size:9pt;">
                            <thead style="background:#eee;">
                                <tr><th>SL#</th><th>Particulars</th><th>Yes</th><th>No</th><th>N/A</th><th>Remarks</th></tr>
                            </thead>
                            <tbody>
                                <t t-set="i" t-value="0"/>
                                <t t-foreach="doc.line_ids" t-as="l">
                                    <t t-set="i" t-value="i + 1"/>
                                    <tr>
                                        <td><t t-out="i"/></td>
                                        <td><t t-out="l.name"/></td>
                                        <td style="text-align:center;"><t t-if="l.status == 'yes'">✔</t></td>
                                        <td style="text-align:center;"><t t-if="l.status == 'no'">✔</t></td>
                                        <td style="text-align:center;"><t t-if="l.status == 'na'">✔</t></td>
                                        <td><t t-out="l.remarks or ''"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        <table style="width:100%; margin-top:45px; text-align:center; font-size:9pt;">
                            <tr>
                                <td style="border-top:1px solid #000; width:40%;">Prepared By</td>
                                <td style="width:20%;"/>
                                <td style="border-top:1px solid #000; width:40%;">Checked By</td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
