<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mcb_exit_interview_list" model="ir.ui.view">
        <field name="name">mcb.hr.exit.interview.list</field>
        <field name="model">mcb.hr.exit.interview</field>
        <field name="arch" type="xml">
            <list>
                <field name="employee_id"/>
                <field name="interview_date"/>
                <field name="interviewer_id"/>
                <field name="reason_overall"/>
                <field name="workplace_rating"/>
                <field name="management_rating"/>
                <field name="would_recommend"/>
            </list>
        </field>
    </record>

    <record id="view_mcb_exit_interview_form" model="ir.ui.view">
        <field name="name">mcb.hr.exit.interview.form</field>
        <field name="model">mcb.hr.exit.interview</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="resignation_id"/>
                            <field name="interview_date"/>
                            <field name="interviewer_id"/>
                        </group>
                        <group>
                            <field name="reason_overall"/>
                            <field name="workplace_rating"/>
                            <field name="management_rating"/>
                            <field name="would_recommend"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Suggestions">
                            <field name="suggestions"/>
                        </page>
                        <page string="Confidential HR Notes" groups="hr.group_hr_user">
                            <field name="confidential_notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_mcb_exit_interview" model="ir.actions.act_window">
        <field name="name">Exit Interviews</field>
        <field name="res_model">mcb.hr.exit.interview</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
